generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @db.VarChar(254)
  normalizedEmail String    @unique(map: "users_normalized_email_key") @map("normalized_email") @db.VarChar(254)
  passwordHash    String    @map("password_hash") @db.Text
  status          String    @default("ACTIVE") @db.VarChar(32)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)
  sessions        Session[]
  memberships     Membership[]

  @@map("users")
}

model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(120)
  slug        String       @unique(map: "organizations_slug_key") @db.VarChar(63)
  status      String       @default("ACTIVE") @db.VarChar(32)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships Membership[]

  @@map("organizations")
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           String       @db.VarChar(32)
  status         String       @default("ACTIVE") @db.VarChar(32)
  joinedAt       DateTime     @default(now()) @map("joined_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "memberships_organization_id_fkey")
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict, map: "memberships_user_id_fkey")

  @@unique([organizationId, userId], map: "memberships_organization_id_user_id_key")
  @@index([userId, status, organizationId], map: "memberships_user_status_organization_idx")
  @@index([organizationId, status, role, id], map: "memberships_organization_status_role_idx")
  @@map("memberships")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenHash        String    @unique(map: "sessions_token_hash_key") @map("token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt       DateTime  @map("last_used_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revocationReason String?   @map("revocation_reason") @db.VarChar(32)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "sessions_user_id_fkey")

  @@index([userId, revokedAt, lastUsedAt], map: "sessions_user_activity_idx")
  @@map("sessions")
}
