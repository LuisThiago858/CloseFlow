# Aplicações
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=/api/v1
LOG_LEVEL=info

# PostgreSQL local — valores exclusivos para desenvolvimento
POSTGRES_DB=closeflow
POSTGRES_USER=closeflow_app
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://closeflow_app:change-me-local-only@localhost:5432/closeflow?schema=public

# PostgreSQL local para testes de integração — serviço isolado e efêmero
POSTGRES_TEST_DB=closeflow_test
POSTGRES_TEST_USER=closeflow_test
POSTGRES_TEST_PASSWORD=change-me-test-only
POSTGRES_TEST_PORT=5433
DATABASE_URL_TEST=postgresql://closeflow_test:change-me-test-only@localhost:5433/closeflow_test?schema=public
